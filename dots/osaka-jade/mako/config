
# Osaka Jade

font=Iosevka 10
background-color=#111C18
text-color=#A3B8A8
border-color=#75B99A

width=340
height=120
margin=12
padding=14

border-size=1
border-radius=0

icons=1
max-icon-size=32

default-timeout=5000
ignore-timeout=0

anchor=top-right
layer=overlay
sort=-time
group-by=app-name

[urgency=low]
text-color=#718A7D
border-color=#304A3D
default-timeout=3000

[urgency=normal]
background-color=#16251E
text-color=#A3B8A8
border-color=#75B99A
default-timeout=5000

[urgency=critical]
background-color=#281B1B
text-color=#D99A91
border-color=#C4746E
default-timeout=0
