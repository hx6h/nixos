{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": { "separator": " " },
  "modules": [
    { "type": "title", "keyColor": "@ACCENT@" },
    { "type": "os", "key": " ", "keyColor": "@FOREGROUND@" },
    { "type": "kernel", "key": " ", "keyColor": "@MUTED@" },
    { "type": "packages", "key": " ", "keyColor": "@MUTED@" },
    { "type": "shell", "key": " ", "keyColor": "@FOREGROUND@" },
    { "type": "terminal", "key": " ", "keyColor": "@MUTED@" },
    { "type": "wm", "key": " ", "keyColor": "@ACCENT@" },
    { "type": "uptime", "key": " ", "keyColor": "@MUTED@" },
    { "type": "datetime", "key": " ", "keyColor": "@FOREGROUND@" },
    { "type": "memory", "key": "󰍛 ", "keyColor": "@MUTED@" }
  ]
}
