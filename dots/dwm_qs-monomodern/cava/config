[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 3
bar_spacing = 1
center_align = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 12000

[input]
method = pipewire
source = auto

[output]
method = noncurses
channels = stereo
orientation = bottom
show_idle_bar_heads = 0
synchronized_sync = 1

[color]
gradient = 1
gradient_count = 8
gradient_color_1 = '@ANSI14@'
gradient_color_2 = '@ANSI13@'
gradient_color_3 = '@ANSI12@'
gradient_color_4 = '@ANSI11@'
gradient_color_5 = '@ANSI10@'
gradient_color_6 = '@ANSI9@'
gradient_color_7 = '@ANSI8@'
gradient_color_8 = '@ANSI7@'

[smoothing]
monstercat = 1
waves = 0
noise_reduction = 77
